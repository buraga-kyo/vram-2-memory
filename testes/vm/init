#!/bin/busybox sh
set -eu

. /configuracao.env

codigo_final=1
processo_do_servidor=""

provar_swap_por_prazo()
{
    alvo=$1
    identidade=$2
    duracao=${DURACAO_DO_SWAP_EM_SEGUNDOS:-1800}
    memoria_mib=$(awk '/MemTotal/ { print int($2 * 80 / 100 / 1024) }' /proc/meminfo)
    test "$(cat "/sys/class/block/${alvo##*/}/dev")" = "$identidade"
    mkswap "$alvo"
    swapon -p -2 "$alvo"
    echo "VM: swap activo por ${duracao}s; pressão=${memoria_mib}MiB."
    /bin/pressionar_memoria "$memoria_mib" "$duracao" &
    pressor=$!
    while kill -0 "$pressor" 2>/dev/null; do
        awk '/MemAvailable|SwapTotal|SwapFree/ { print }' /proc/meminfo
        sleep 30
    done
    wait "$pressor"
    swapoff "$alvo"
    ! grep -F -- "$alvo" /proc/swaps
}

# Proposito: restituir a instância e entregar a sentença ao hospedeiro.
restituir_machina()
{
    set +e
    if [ -S /run/vramdisk/0/control.sock ]; then
        LD_LIBRARY_PATH=/lib /bin/vramdiskctl destroy 0
    fi
    if [ -n "$processo_do_servidor" ]; then
        wait "$processo_do_servidor"
    fi
    sync
    /bin/encerrar_vm "$codigo_final"
    poweroff -f
}

trap restituir_machina EXIT HUP INT TERM

/bin/busybox --install -s /bin
mkdir -p /proc /sys /dev /run /tmp
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
echo /bin/mdev > /proc/sys/kernel/hotplug
mdev -s
ulimit -l unlimited
insmod /lib/modules/ublk_drv.ko

echo "VM: núcleo e ublk_drv preparados."

set -- /sys/class/block/ublkb*
if [ -e "$1" ]; then
    echo "VM: a machina não principiou sem ublk." >&2
    exit 20
fi

LD_LIBRARY_PATH=/lib /bin/vramdiskd --backend simulado --audiencias 3 0 &
processo_do_servidor=$!

tentativa=0
while [ ! -S /run/vramdisk/0/control.sock ] && [ "$tentativa" -lt 60 ]; do
    sleep 1
    tentativa=$((tentativa + 1))
done
test -S /run/vramdisk/0/control.sock

LD_LIBRARY_PATH=/lib /bin/vramdiskctl create 0 \
    "$CAPACIDADE_DO_APPARELHO" "$QUANTIDADE_DE_FILAS" \
    "$PROFUNDIDADE_DAS_FILAS" "$MAIOR_OPERACAO" \
    "$PRAZO_DA_OPERACAO" 0

tentativa=0
set -- /sys/class/block/ublkb*
while [ ! -e "$1" ] && [ "$tentativa" -lt 60 ]; do
    sleep 1
    tentativa=$((tentativa + 1))
    set -- /sys/class/block/ublkb*
done
test "$#" -eq 1
test -e "$1"

nome_do_bloco=${1##*/}
dispositivo="/dev/$nome_do_bloco"
test -b "$dispositivo"
major_e_minor=$(cat "$1/dev")
test -n "$major_e_minor"
test "$(readlink -f "/sys/dev/block/$major_e_minor")" = "$(readlink -f "$1")"
sectores=$(cat "$1/size")
test "$sectores" -eq "$((CAPACIDADE_DO_APPARELHO / 512))"

retrato_do_servico=$(LD_LIBRARY_PATH=/lib /bin/vramdiskctl status 0)
echo "$retrato_do_servico"
case "$retrato_do_servico" in
    *'"estado":"SERVINDO"'*) ;;
    *) echo "Estado operacional ausente." >&2; exit 21 ;;
esac

echo "VM: bloco $nome_do_bloco, par $major_e_minor, capacidade provada."

/bin/provar_operacao_invalida "$dispositivo"

/bin/fio --name=bloco_4k --filename="$dispositivo" \
    --offset=0 --size=268435456 --bs=4k --rw=randrw --rwmixread=50 \
    --direct=1 --ioengine=psync --verify=crc32c --verify_fatal=1 \
    --time_based=1 --runtime="$DURACAO_DO_FIO_EM_SEGUNDOS" \
    --name=bloco_64k --filename="$dispositivo" \
    --offset=268435456 --size=268435456 --bs=64k --rw=randrw --rwmixread=50 \
    --direct=1 --ioengine=psync --verify=crc32c --verify_fatal=1 \
    --time_based=1 --runtime="$DURACAO_DO_FIO_EM_SEGUNDOS" \
    --name=bloco_1m --filename="$dispositivo" \
    --offset=536870912 --size=536870912 --bs=1m --rw=randrw --rwmixread=50 \
    --direct=1 --ioengine=psync --verify=crc32c --verify_fatal=1 \
    --time_based=1 --runtime="$DURACAO_DO_FIO_EM_SEGUNDOS" \
    --group_reporting=1

LD_LIBRARY_PATH=/lib /bin/vramdiskctl destroy 0
wait "$processo_do_servidor"
processo_do_servidor=""

test ! -e "/sys/class/block/$nome_do_bloco"
test ! -e "$dispositivo"
test ! -e /run/vramdisk/0
set -- /sys/class/block/ublkb*
test ! -e "$1"
rmmod ublk_drv

echo "VM: operação inválida, fio e restituição demonstrados."
codigo_final="$CODIGO_DE_EXITO_DA_VM"
